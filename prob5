import java.util.Scanner;

class LibraryException extends Exception {
    public LibraryException(String message) {
        super(message);
    }
}

class Book {
    private final int id;
    private final String title;
    private final int totalCopies;
    private int available;
    private int borrowed;

    public Book(int id, String title, int copies) {
        this.id = id;
        this.title = title;
        this.totalCopies = copies;
        this.available = copies;
        this.borrowed = 0;
    }

    public int getId() { return id; }
    public String getTitle() { return title; }
    public int getTotalCopies() { return totalCopies; }
    public int getAvailable() { return available; }
    public int getBorrowed() { return borrowed; }

    // Package-private: only Library changes counts, and only after validation passes.
    void applyBorrow() {
        available--;
        borrowed++;
    }

    void applyReturn() {
        available++;
        borrowed--;
    }

    public String status() {
        return "Available " + available + ", borrowed " + borrowed;
    }

    @Override
    public String toString() {
        return id + " " + title + ": " + status();
    }
}

class Library {
    private final Book[] books;
    private final int initialTotal;

    public Library() {
        books = new Book[] {
            new Book(1, "Java Basics", 2),
            new Book(2, "Algorithms", 1),
            new Book(3, "Databases", 0)
        };
        initialTotal = totalCopies();
    }

    public Book borrow(int id) throws LibraryException {
        Book book = findOrThrow(id);
        // All checks run before any count changes, so a rejected borrow changes nothing.
        if (book.getAvailable() == 0) {
            throw new LibraryException("No copies available.");
        }
        book.applyBorrow();
        return book;
    }

    public Book returnCopy(int id) throws LibraryException {
        Book book = findOrThrow(id);
        if (book.getBorrowed() == 0) {
            throw new LibraryException("No borrowed copies to return.");
        }
        book.applyReturn();
        return book;
    }

    public Book find(int id) throws LibraryException {
        return findOrThrow(id);
    }

    public void listAll() {
        for (Book book : books) {
            System.out.println(book);
        }
    }

    // Throws if the total number of copies has changed, which would mean a bug.
    public void verifyInvariant() {
        if (totalCopies() != initialTotal) {
            throw new IllegalStateException("Invariant broken: total copies changed.");
        }
    }

    private int totalCopies() {
        int total = 0;
        for (Book book : books) {
            total += book.getAvailable() + book.getBorrowed();
        }
        return total;
    }

    private Book findOrThrow(int id) throws LibraryException {
        for (Book book : books) {
            if (book.getId() == id) {
                return book;
            }
        }
        throw new LibraryException("Book not found.");
    }
}

public class Main {
    public static void main(String[] args) {
        Library library = new Library();
        Scanner in = new Scanner(System.in);
        boolean running = true;

        while (running) {
            System.out.println("\nMenu: 1 Borrow | 2 Return | 3 Find | 4 List | 0 Exit");
            System.out.print("Choice: ");
            String choice = in.nextLine().trim();

            try {
                switch (choice) {
                    case "1" -> {
                        int id = readInt(in, "Enter ID: ");
                        System.out.println(library.borrow(id).status());
                    }
                    case "2" -> {
                        int id = readInt(in, "Enter ID: ");
                        System.out.println(library.returnCopy(id).status());
                    }
                    case "3" -> {
                        int id = readInt(in, "Enter ID: ");
                        System.out.println(library.find(id).status());
                    }
                    case "4" -> library.listAll();
                    case "0" -> {
                        running = false;
                        System.out.println("Goodbye.");
                    }
                    default -> System.out.println("Invalid choice.");
                }
            } catch (LibraryException e) {
                // Business-rule and input errors land here. No state changed.
                System.out.println("Error: " + e.getMessage());
            } finally {
                // Runs after every menu action, including rejected ones.
                library.verifyInvariant();
            }
        }
        in.close();
    }

    private static int readInt(Scanner in, String prompt) throws LibraryException {
        System.out.print(prompt);
        String text = in.nextLine().trim();
        try {
            return Integer.parseInt(text);
        } catch (NumberFormatException e) {
            throw new LibraryException("Enter a valid number.");
        }
    }
}